<header class="navbar px-4 sm:px-6 lg:px-8 bg-base-200">
  <div class="flex-1">
    <a
      href="/"
      class="flex items-center gap-2 font-brand font-black text-2xl tracking-wide"
    >
      🏰 Camelot AI
    </a>
  </div>
  <div class="flex-none">
    <ul class="flex px-1 space-x-2 items-center">
      <li>
        <a href="/" class="btn btn-ghost btn-sm">
          Board
        </a>
      </li>
      <li>
        <a href="/projects" class="btn btn-ghost btn-sm">
          Projects
        </a>
      </li>
      <%= if match?(%{role: :admin}, assigns[:current_user]) do %>
        <li>
          <a href="/agents" class="btn btn-ghost btn-sm">
            Agent CLI
          </a>
        </li>
      <% end %>
      <li>
        <a href="/prompts" class="btn btn-ghost btn-sm">
          Prompts
        </a>
      </li>
      <li>
        <a href={CamelotWeb.Layouts.docs_url()} class="btn btn-ghost btn-sm" target="_blank">
          Docs
        </a>
      </li>
      <%= if match?(%{role: :admin}, assigns[:current_user]) do %>
        <li>
          <a href="/admin/users" class="btn btn-ghost btn-sm">
            Users
          </a>
        </li>
      <% end %>
      <li>
        <.theme_toggle />
      </li>
      <%= if assigns[:current_user] do %>
        <li class="dropdown dropdown-end">
          <div
            tabindex="0"
            role="button"
            id="user-menu"
            aria-label="Account menu"
            class="btn btn-ghost btn-circle avatar avatar-placeholder"
          >
            <div class="bg-neutral text-neutral-content w-8 rounded-full">
              <span>{CamelotWeb.Layouts.user_initial(@current_user)}</span>
            </div>
          </div>
          <ul
            id="user-menu-items"
            tabindex="0"
            class="menu dropdown-content bg-base-100 rounded-box z-10 mt-3 w-60 p-2 shadow"
          >
            <li class="menu-title truncate">{@current_user.email}</li>
            <li><.link navigate={~p"/profile/ssh-key"}>SSH key</.link></li>
            <li>
              <.link navigate={~p"/profile/notifications"}>
                Email notifications
              </.link>
            </li>
            <li><.link navigate={~p"/profile/api-keys"}>API keys</.link></li>
            <li>
              <.link navigate={~p"/profile/capacity"}>Running capacity</.link>
            </li>
            <li><.link navigate={~p"/profile/github"}>GitHub</.link></li>
            <li class="divider my-0"></li>
            <li><a href="/sign-out" data-posthog-reset>Sign out</a></li>
          </ul>
        </li>
      <% end %>
    </ul>
  </div>
</header>

<%= if assigns[:onboarding] do %>
  <.welcome_modal
    onboarding={@onboarding}
    show={assigns[:onboarding_modal?] == true}
  />
  <.setup_bar onboarding={@onboarding} />
<% end %>

<main class="px-4 py-8 sm:px-6 lg:px-8">
  <div class="mx-auto max-w-6xl space-y-4">
    {@inner_content}
  </div>
</main>

<.flash_group flash={@flash} />
